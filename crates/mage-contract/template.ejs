            write!(formatter, "{:0>offset_width$} <%- name.base -%>", offset, offset_width = offset_width)?;
            <%_ for (const field of data) { _%>
            write!(formatter, " <%- field.name -%>:<%- field.kind === 'offset' ? 'o' : 'i' -%>{}", instruction_data.<%- field.name -%>)?;
            <%_ } _%>
            writeln!(formatter)
