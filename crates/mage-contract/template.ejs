        line: line_number,
        message: format!("missing ':' in operand '{}'", text),
    })?;

    let kind_and_value = &text[colon_position + 1..];
    if kind_and_value.is_empty() {
        return Err(ParseError::InvalidOperand {
            line: line_number,
            message: format!("missing kind prefix in operand '{}'", text),
        });
    }

    let kind = match kind_and_value.as_bytes()[0] {
        b'o' => OperandKind::Offset,
        b'i' => OperandKind::Immutable,
        other => {
            return Err(ParseError::InvalidOperand {
                line: line_number,
                message: format!(
                    "invalid kind prefix '{}' in operand '{}', expected 'o' or 'i'",
                    other as char, text
                ),
            });
        }
    };

    let value_string = &kind_and_value[1..];
    let value: u64 = value_string.parse().map_err(|_| ParseError::InvalidOperand {
        line: line_number,
        message: format!("invalid number '{}' in operand '{}'", value_string, text),
    })?;

    Ok((kind, value))
}

fn parse_text_line(line: &str, line_number: usize) -> Result<Instruction, ParseError> {
    let line = line.trim();

    let mut parts = line.split_whitespace();
    parts.next();

    let name = parts.next().ok_or_else(|| ParseError::InvalidLine {
        line: line_number,
        message: "missing instruction name".to_string(),
    })?;

    let mut operands = Vec::new();
    for part in parts {
        operands.push(parse_text_operand(part, line_number)?);
    }

    text_to_instruction(name, &operands).ok_or_else(|| ParseError::UnknownInstruction {
        line: line_number,
        name: name.to_string(),
    })
}

fn parse_json_operand(value: &serde_json::Value, index: usize) -> Result<(OperandKind, u64), ParseError> {
    let kind_string = value.get("kind").and_then(|kind| kind.as_str()).ok_or_else(|| {
        ParseError::InvalidOperand {
            line: index,
            message: "operand missing 'kind' field".to_string(),
        }
    })?;

    let kind = match kind_string {
        "Offset" => OperandKind::Offset,
        "Immutable" => OperandKind::Immutable,
        other => {
            return Err(ParseError::InvalidOperand {
                line: index,
                message: format!("invalid operand kind '{}', expected 'Offset' or 'Immutable'", other),
            });
        }
    };

    let data = value.get("data").and_then(|data| data.as_u64()).ok_or_else(|| {
        ParseError::InvalidOperand {
            line: index,
            message: "operand missing 'data' field".to_string(),
        }
    })?;

    Ok((kind, data))
}
