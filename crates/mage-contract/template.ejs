                <%_ for (let fieldIndex = 0; fieldIndex < data.length; fieldIndex++) { _%>
                <%- data[fieldIndex].name -%>: operands[<%- fieldIndex -%>].1,
                <%_ } _%>
            }))
        }
        <%_ } else { _%>
        "<%- name.base -%>" if operands.is_empty() => Some(Instruction::<%- name.camel -%>),
        <%_ } _%>
        <%_ }) _%>
        _ => None,
