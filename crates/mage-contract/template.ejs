#[inline]
fn decimal_width(mut value: u64) -> usize {
    if value == 0 {
        return 1;
    }
    let mut width = 0;
    while value > 0 {
        value /= 10;
        width += 1;
    }
    width
}

fn measure_instruction(instruction: &Instruction) -> (usize, usize, [usize; MAX_OPERANDS]) {
    let mut widths = [0usize; MAX_OPERANDS];
    match instruction {
        <%_ iterate(instructions, (index, name, data) => { _%>
        <%_ if (Array.isArray(data)) { _%>
        Instruction::<%- name.camel -%>(instruction_data) => {
            <%_ for (let fieldIndex = 0; fieldIndex < data.length; fieldIndex++) { _%>
            widths[<%- fieldIndex -%>] = <%- data[fieldIndex].name.length -%> + 2 + decimal_width(instruction_data.<%- data[fieldIndex].name -%>);
            <%_ } _%>
            (<%- name.base.length -%>, <%- data.length -%>, widths)
        }
        <%_ } else { _%>
        Instruction::<%- name.camel -%> => (<%- name.base.length -%>, 0, widths),
        <%_ } _%>
        <%_ }) _%>
    }
}

fn write_operand_padded(
    formatter: &mut dyn fmt::Write,
    name: &str,
    prefix: char,
    value: u64,
    pad_to_width: usize,
) -> fmt::Result {
    write!(formatter, " {}:{}{}", name, prefix, value)?;
    let actual = name.len() + 2 + decimal_width(value);
    let pad = pad_to_width.saturating_sub(actual);
    if pad > 0 {
        write!(formatter, "{:pad$}", "", pad = pad)?;
    }
    Ok(())
}

