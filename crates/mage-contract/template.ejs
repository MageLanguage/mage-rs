impl fmt::Display for ParseError {
    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            ParseError::InvalidLine { line, message } => {
                write!(formatter, "line {}: {}", line + 1, message)
            }
            ParseError::UnknownInstruction { line, name } => {
                write!(formatter, "line {}: unknown instruction '{}'", line + 1, name)
            }
            ParseError::InvalidOperand { line, message } => {
                write!(formatter, "line {}: {}", line + 1, message)
            }
            ParseError::InvalidJson { message } => {
                write!(formatter, "invalid JSON: {}", message)
            }
        }
    }
}

