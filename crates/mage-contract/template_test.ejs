#[test]
fn text_decode_unknown_instruction_is_error() {
    let result = Writer::from_text("000 BogusInstruction\n");
    assert!(result.is_err());
    if let Err(ParseError::UnknownInstruction { name, .. }) = &result {
        assert_eq!(name, "BogusInstruction");
    } else {
        panic!("expected UnknownInstruction, got {:?}", result);
    }
}

