// Code generated by build.js from template_test.ejs and bytecode.yaml. DO NOT EDIT.

use crate::*;

fn encode(instructions: &[Instruction]) -> Vec<u8> {
    let mut writer = Writer::new();
    for instruction in instructions {
        writer.write(instruction);
    }
    writer.bytecode
}

fn assert_round_trip(instructions: &[Instruction]) {
    let original = encode(instructions);

    for format in [Format::Simple, Format::Pretty] {
        let reader = Reader::new(&original).unwrap();
        let text = if matches!(format, Format::Pretty) {
            serde_text::to_string_pretty(&reader)
        } else {
            serde_text::to_string(&reader)
        };

        let reconstructed = Writer::from_text(&text).unwrap();

        assert_eq!(
            original, reconstructed,
            "round-trip mismatch ({:?} format).\n--- text ---\n{}",
            format, text,
        );
    }
}

fn assert_json_round_trip(instructions: &[Instruction]) {
    let original = encode(instructions);

    let reader = Reader::new(&original).unwrap();
    let json = serde_json::to_string(&reader).unwrap();
    let reconstructed = Writer::from_json(&json).unwrap();

    assert_eq!(
        original, reconstructed,
        "JSON round-trip mismatch.\n--- json ---\n{}",
        json,
    );
}

#[test]
fn encoder_empty_bytecode() {
    let reader = Reader::new(&[]).unwrap();
    assert_eq!(reader.instruction_count(), 0);
    assert_eq!(reader.bytecode_size(), 0);
    let output = serde_text::to_string_pretty(&reader);
    assert!(output.contains("(empty)"));
}

#[test]
fn encoder_single_exit() {
    let bytecode = encode(&[Instruction::ExitCodeImmutable(ExitCodeImmutable {
        code: 0,
    })]);

    let reader = Reader::new(&bytecode).unwrap();
    assert_eq!(reader.instruction_count(), 1);
    assert_eq!(reader.bytecode_size(), 16);

    let output = serde_text::to_string_pretty(&reader);
    assert!(output.contains("Exit"));
    assert!(output.contains("code:i0"));
}

