#[test]
fn encoder_pretty_alignment() {
    let bytecode = encode(&[
        Instruction::TakeStackSizeImmutable(TakeStackSizeImmutable { stack_size: 48 }),
        Instruction::JumpToImmutable(JumpToImmutable { to: 40 }),
        Instruction::ExitCodeOffset(ExitCodeOffset { code: 0 }),
        Instruction::LoadTargetOffsetSourceImmutable(LoadTargetOffsetSourceImmutable {
            target: 48,
            source: 0,
        }),
        Instruction::FreeStackSizeImmutable(FreeStackSizeImmutable { stack_size: 48 }),
        Instruction::JumpToImmutable(JumpToImmutable { to: 24 }),
    ]);

    let reader = Reader::new(&bytecode).unwrap();
    let output = serde_text::to_string_pretty(&reader);

    let lines: Vec<&str> = output.lines().collect();
    assert_eq!(lines.len(), 6);

    assert!(lines[0].starts_with("000"));
    assert!(lines[1].starts_with("016"));
    assert!(lines[2].starts_with("032"));
    assert!(lines[3].starts_with("048"));
    assert!(lines[4].starts_with("072"));
    assert!(lines[5].starts_with("088"));
}

#[test]
fn encoder_simple_no_padding() {
    let bytecode = encode(&[Instruction::ExitCodeImmutable(ExitCodeImmutable {
        code: 42,
    })]);

    let pretty = Reader::new(&bytecode).unwrap();
    let simple = Reader::new(&bytecode).unwrap();

    let pretty_output = serde_text::to_string_pretty(&pretty);
    let simple_output = serde_text::to_string(&simple);

    assert!(pretty_output.contains("Exit"));
    assert!(simple_output.contains("Exit"));
    assert!(pretty_output.contains("code:i42"));
    assert!(simple_output.contains("code:i42"));
}

#[test]
fn encoder_operand_kinds_distinguished() {
    let bytecode = encode(&[
        Instruction::LoadTargetOffsetSourceOffset(LoadTargetOffsetSourceOffset {
            target: 0,
            source: 8,
        }),
        Instruction::LoadTargetOffsetSourceImmutable(LoadTargetOffsetSourceImmutable {
            target: 0,
            source: 42,
        }),
        Instruction::ExitCodeImmutable(ExitCodeImmutable { code: 0 }),
    ]);

    let reader = Reader::new(&bytecode).unwrap();
    let output = serde_text::to_string(&reader);
    let lines: Vec<&str> = output.lines().collect();

    assert!(lines[0].contains("target:o0"));
    assert!(lines[0].contains("source:o8"));

    assert!(lines[1].contains("target:o0"));
    assert!(lines[1].contains("source:i42"));
}

